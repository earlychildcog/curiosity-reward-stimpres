function flagResult = playTrial3(xp, idStimInPosition, trialtype)
% idStimInPosition: 2xn array


idStimInPosition = [6 2 3; 2 6 3];

%% types of trials

switch trialtype
    case "famColour"             % colouring
        flagCurtain = 0;
        flagBox = false;
        flagAnimation = false;
        flagExtra = true;
    case "visible"           % visible
        flagCurtain = 1;
        flagExtra = true;
    case "invisible"           % invisible
        flagCurtain = 2;
        flagExtra = true;
end

%%
flagResult = 1;
flagLoop        = true;
flagNewTrial    = true; 
maxFrameColouring = 4;
maxFrameRewarding = 12;
key = xp.keyboard. key;
if xp.eegon
    NetStation('StartRecording');
end

while flagLoop
    
%%% start new trial settings
    if flagNewTrial

        nStimTotal = xp.settings.nStimTotal;            % total number of stims
        timeToTrigger = xp.settings.timeToTrigger;            % time for fixation to trigger
        timeOut = xp.settings.timeOut;                 % time fixating away to reset fixation timer
        occrect = xp.settings.occrect;                  % 
        
        % identify stimuli
        if flagExtra
            idStimExtra = idStimInPosition(end,end); % extra stim(s) in the beginning; put empty array for none
        else
            idStimExtra = [];
        end
        nStimOnScreen = size(idStimInPosition,2)-flagExtra;      % how many on screen (experiment phase)

        idStimFinalPos = idStimInPosition(2,1:nStimOnScreen);
        idStimColouring = 3 + idStimFinalPos;
        idStimReward = idStimColouring + nStimTotal;
        
        iEvent = 0;

                       
        idStimInitialPos = idStimInPosition(1,:);
        % draw stimuli
        
        textureArray = xp.image.texture([idStimColouring (3 + idStimExtra)],1);

        % flags››
        flagNewTrial = 0;                           % starts new trial
        flagObjectState = zeros(1, nStimOnScreen);  % states: 0 - hidden, 1 - partially revealled, 2 - fully revealed, 3 - reward animating
        flagOccluderState = zeros(1, nStimOnScreen); % 0: full, 1: done, in between: partial
        stepOccluderReveal = 0.100001;
        roiReward = 0;
        roiAnimating = 0;                               % which object currently being animated (0 if none)
        iFrameColouring = zeros(1, nStimOnScreen);      % which colouring frame we are on
        iFrameRewarding = zeros(1, nStimOnScreen);      % which reward frame we are on
        
        timeLastIn = repmat(GetSecs, 1, nStimOnScreen+1);       % timestamp of last visit of ROI (starting with rest of screen roi)
        trigOnset = NaN;

%         eventFrameMatrix = zeros(600, 5);                       % to store some stuff
        roiFixLast = 0;
        durFixIn = 0;

                Screen('DrawTexture', xp.screen.win, xp.image.texture{3,1}, [], xp.screen.rect(:,1) + xp.screen.rect(4,1)*[0 -0.8 0 -0.8]');

        % draw background
        Screen('DrawTexture', xp.screen.win, xp.image.texture{1,1}, [], xp.screen.rect(:,1));

        % draw objects
        for iObject = 1:(nStimOnScreen + flagExtra)
            Screen('DrawTexture', xp.screen.win, textureArray{iObject}, [], xp.screen.rect(:,4 + idStimInitialPos(iObject)), 0, []);
        end

            % draw occluders
        for iObject = 1:nStimOnScreen
            Screen('DrawTexture', xp.screen.win, xp.image.texture{3,2}, [], occrect + xp.screen.rect(:,1 + iObject));
        end
        
        stimOnset0 = xp.flip;
        stimOnset = stimOnset0;
        

    % first present objects
        while GetSecs - stimOnset < 5
    
        end
    
        %%% curtain down and up
        if flagCurtain
            stimOnset = GetSecs;
            durCurtain = 1;
            timeStep = 1/30;
            kStep = 2*timeStep/durCurtain;
            for k=-1:kStep:0:kStep:1
                Screen('DrawTexture', xp.screen.win, xp.image.texture{1,1}, [], xp.screen.rect(:,1));    
                % draw objects
                    for iObject = 1:(nStimOnScreen + flagExtra*(k<0))
                        if k<0
                            Screen('DrawTexture', xp.screen.win, textureArray{iObject}, [], xp.screen.rect(:,1 + 3*(k<0) + idStimInitialPos(iObject)), 0, []);
                        else
                            Screen('DrawTexture', xp.screen.win, textureArray{iObject}, [], xp.screen.rect(:,1 + 3*(k<0) + iObject), 0, []);
                        end
                    end
                % draw occluders
                for iObject = 1:nStimOnScreen
                    Screen('DrawTexture', xp.screen.win, xp.image.texture{3,2}, [], occrect + xp.screen.rect(:,1 + iObject));
                end
                % draw curtain
                Screen('DrawTexture', xp.screen.win, xp.image.texture{3,1}, [], xp.screen.rect(:,1) + xp.screen.rect(4,1)*[0 -0.2-abs(k) 0 -0.2-abs(k)]');
    
                stimOnset = xp.flip(stimOnset + timeStep);
                if k == 0
                    xp.sound.play
                    WaitSecs(1)
                end           
            end
        else    % objects move!
            
            stimOnset = GetSecs;
            durCurtain = 1;
            timeStep = 1/30;
            kStep = timeStep/durCurtain;
            
            rectOut = xp.screen.rect(:,5) - [xp.screen.rect(3,4) 0 xp.screen.rect(3,4) 0]';     % we create a rectangle out of the screen for the extra object
            
            xp.sound.play
            for k=0:kStep:1
                
                rectTraject = round(xp.screen.rect(:,idStimInitialPos + 4)*(1-k) + k*[xp.screen.rect(:,1 + (1:nStimOnScreen)) rectOut]);
                
                Screen('DrawTexture', xp.screen.win, xp.image.texture{1,1}, [], xp.screen.rect(:,1));    
                Screen('DrawTexture', xp.screen.win, xp.image.texture{3,1}, [], xp.screen.rect(:,1) + xp.screen.rect(4,1)*[0 -0.8 0 -0.8]');

                % draw objects
                    for iObject = 1:(nStimOnScreen + flagExtra)
                        Screen('DrawTexture', xp.screen.win, textureArray{iObject}, [], rectTraject(:,iObject), 0, []);
                    end
                % draw occluders
                for iObject = 1:nStimOnScreen
                    Screen('DrawTexture', xp.screen.win, xp.image.texture{3,2}, [], occrect + xp.screen.rect(:,1 + iObject));
                end
                % draw curtain
    
                stimOnset = xp.flip(stimOnset + timeStep);
            end
        end



%%% begin trial
%         % draw background
                Screen('DrawTexture', xp.screen.win, xp.image.texture{3,1}, [], xp.screen.rect(:,1) + xp.screen.rect(4,1)*[0 -0.8 0 -0.8]');
        Screen('DrawTexture', xp.screen.win, xp.image.texture{1,1}, [], xp.screen.rect(:,1));
        
        % draw objects
        for iObject = 1:nStimOnScreen
            Screen('DrawTexture', xp.screen.win, textureArray{iObject}, [], xp.screen.rect(:,1 + iObject), 0, []);
        end

        % draw occluders
        for iObject = 1:nStimOnScreen
            Screen('DrawTexture', xp.screen.win, xp.image.texture{3,2}, [], occrect + xp.screen.rect(:,1 + iObject));
        end
        stimOnset = xp.flip(stimOnset + 2);
    end
    
%%% checking fixations in boxes
    [roiFix, timeFix] = xp.fixCheck(1+(1:nStimOnScreen), true);
    

    % get how long fixation has been going
    % if fixation is lost, then timer resets to new roi after $timeOut seconds
    if roiFix == roiFixLast
        durFixIn = durFixIn + timeFix - timeLastIn(roiFix + 1);      % update duration if continuing fixating !!! Need to make sure no rounding errors mess things too much, too many additions? !!!!
        timeLastIn(roiFix + 1) = timeFix;
%         if debugthing
%             fprintf("out %d..", roiFix)
%             debugthing = false;
%         else
%             fprintf("\b\b\b\b\b\b\b")
%             debugthing = true;
%         end
    else
        durFixOut = timeFix - timeLastIn(roiFixLast + 1);                   % seconds not looking on last roi
        timeLastIn(roiFix + 1) = timeFix;
        
        if durFixOut > timeOut        
%             fprintf("fixating in %d after %.2f from %d: status", roiFix, durFixOut, roiFixLast)
%             fprintf(" %d",flagObjectState, roiAnimating)
%             fprintf("\n")
%             debugthing = true;                                  
            durFixIn = min(timeFix - timeLastIn(timeLastIn ~= timeFix));
            roiFixLast = roiFix;
        end
    end
 
%%% loop control part
    if durFixIn > timeToTrigger       % if fixation has been for long enough
        if roiFix > 0                       % if we have fixation right now on some object
            switch flagObjectState(roiFix)
        % if object still hidden, and fixated there long enough: start revealing
                case 0 
                    if all(flagObjectState == 0)
                        roiReward = roiFix;
                        trigOnset = timeFix;
                    end
                    flagObjectState(roiFix) = 1;
                    roiAnimating = roiFix;
        % if object partially revealed, continue revealing
                case 1
                    if iFrameColouring(roiFix) < maxFrameColouring         
                        roiAnimating = roiFix;
                    else                                            % if fully coloured...
                        if roiReward == roiFix               % if first to get fully coloured, start reward animation.
                            flagObjectState(roiFix) = 3;
                            roiAnimating = roiFix;
                        else                                        % if another already in reward, just freeze it fully revealed
                            flagObjectState(roiFix) = 2;
                            roiAnimating = 0;
                            flagObjectState(roiReward) = 2;     
                        end
                    end
        % object fully revealed, but not gonna animate reward
                case 2
                    roiAnimating = 0;
        % object in reward animation phase
                case 3
                    roiAnimating = roiFix;
            end
        else
            roiAnimating = 0;
        end
    elseif roiAnimating > 0     % for the case that there are fixations to other ROIs that cummilatively add more than timeToTrigger
        if GetSecs - timeLastIn(roiAnimating + 1) > timeToTrigger
            roiAnimating = 0;
        end
    end
    
%%% draw the new frame to present
    if roiAnimating > 0 && GetSecs - stimOnset > 0.09


        switch flagObjectState(roiAnimating)
        
        % if colouring animation 
            case 1  
%                 if flagOccluderState(roiAnimating) < 0.6             % first occluder falls
%                     flagOccluderState(roiAnimating) = flagOccluderState(roiAnimating) + stepOccluderReveal;
%                 else                                                % then object gets coloured
%                     iFrameColouring(roiAnimating) = iFrameColouring(roiAnimating) + 1;
%                     textureArray{roiAnimating} = xp.image.texture{idStimColouring(roiAnimating),iFrameColouring(roiAnimating)};
%                 end
                iFrameColouring(roiAnimating) = iFrameColouring(roiAnimating) + 1;
                flagOccluderState(roiAnimating) = flagOccluderState(roiAnimating) + stepOccluderReveal;
                textureArray{roiAnimating} = xp.image.texture{idStimColouring(roiAnimating),iFrameColouring(roiAnimating)};
        % if rewarding animation
            case 3
                iFrameRewarding(roiAnimating) = iFrameRewarding(roiAnimating) + 1;
                if iFrameRewarding(roiAnimating) > maxFrameRewarding
                    iFrameRewarding(roiAnimating) = 1;
                end
                textureArray{roiAnimating} = xp.image.texture{idStimReward(roiAnimating),iFrameRewarding(roiAnimating)};
        end

        % draw background
        Screen('DrawTexture', xp.screen.win, xp.image.texture{1,1}, [], xp.screen.rect(:,1));

        % draw objects
        for iObject = 1:nStimOnScreen
            disp(nStimOnScreen)
            disp(iObject)
            disp(textureArray)
            Screen('DrawTexture', xp.screen.win, textureArray{iObject}, [], xp.screen.rect(:,1 + iObject), 0, []);
        end

        % draw boxes, for objects still hidden
        for iObject = 1:nStimOnScreen
            thisBox = occrect + xp.screen.rect(:,1 + iObject);
            thisBox = thisBox + thisBox(2)*[0 flagOccluderState(iObject) 0 flagOccluderState(iObject)]';
            thisBox
            flagOccluderState(iObject)
            Screen('DrawTexture', xp.screen.win, xp.image.texture{3,2}, [], thisBox);
%             if flagObjectState(iObject) == 0
%                 Screen('DrawTexture', xp.screen.win, xp.image.texture{3,2}, [], occrect + xp.screen.rect(:,1 + iObject));
%             elseif flagObjectState(iObject) == 1
%                 Screen('DrawTexture', xp.screen.win, xp.image.texture{3,2}, [], occrect + xp.screen.rect(:,1 + iObject), [], [], 1-iFrameColouring(iObject)/maxFrameColouring);
%             end
        end
        
        stimOnset = Screen('Flip',xp.screen.win,stimOnset + 0.1,0);
        
        iEvent = iEvent + 1;
%         eventFrameMatrix(iEvent, :) = [stimOnset roiAnimating flagObjectState(roiAnimating) iFrameColouring(roiAnimating)+iFrameRewarding(roiAnimating)];
%         Eyelink('Message', 'New Frame: ROI %d fullstate %d %d frameid %d', roiAnimating, flagObjectState,  iFrameColouring(roiAnimating)+iFrameRewarding(roiAnimating))
    end
    

%%% keyboard check
    [keyIsDown,~,keyCode] = PsychHID('KbCheck', xp.keyboard.index);      %reads key pressed
    if keyIsDown
        switch find(keyCode,1)
            case key.escape
                flagLoop = false;
            case key.q
                flagLoop = false;
                xp.finish;
            case key.space
                flagNewTrial = 1;
        end
    end


%%% end of trial check
    if any(flagObjectState == 2)
        endAfter = timeFix + 1 - GetSecs;   % 1 second after fully revealing second object, end trial
        WaitSecs(endAfter)
        flagNewTrial = 1;
    end
    if GetSecs - trigOnset > 10 || GetSecs - stimOnset0 > 60
        flagNewTrial = 1;        
    end
end